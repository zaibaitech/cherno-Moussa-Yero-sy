# Supabase (books storage, auth, and any Deftere-specific tables)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Asrar ephemeris API — spec §6. supabase/functions/ephemeris in asrar-mobile
# returns raw planetary positions; confirm it's callable cross-project (CORS,
# auth) before wiring the dashboard cards to it.
ASRAR_EPHEMERIS_API_URL=

# Wave — Phase 1 uses the static pay link in lib/wave.ts, no key needed.
# Phase 2 (Checkout API, docs.wave.com/checkout) will need a server-side key:
# WAVE_API_KEY=
